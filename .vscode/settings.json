{
  "files.associations": {
    "typeinfo": "cpp",
    "*.INFO": "log",
    "*.S": "gas",
    "*.sy": "c",
    "*.WARNING": "log",
    "runtime.h": "c",
    "identity.h": "c",
    "cstdlib": "c",
    "cstdint": "cpp"
  },
  "eslint.rules.customizations": [
    {
      "rule": "prettier/prettier",
      "severity": "off",
    }
  ]
}